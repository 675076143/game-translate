#!/usr/bin/env bash
set -euo pipefail

clients="$(hyprctl clients -j 2>/dev/null)"
if ! jq -e 'type == "array"' <<<"$clients" >/dev/null 2>&1; then
    echo "无法读取 Hyprland 窗口列表" >&2
    exit 1
fi

if jq -e '.[] | select(.title == "GT-Translate")' <<<"$clients" >/dev/null; then
    hyprctl dispatch 'hl.dsp.window.close({ window = "title:GT-Translate" })'
    exit 0
fi

setsid -f kitty --class GT-Translate --title GT-Translate \
    -o font_size=15 \
    -o background=#1e1e2e \
    -o foreground=#cdd6f4 \
    -o window_padding_width=10 \
    -e /home/robin/.local/bin/game-translate "$@"
